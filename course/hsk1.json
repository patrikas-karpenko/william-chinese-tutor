      {
       "zh": "我叫李月。",
       "pinyin": "Wǒ jiào Lǐ Yuè.",
       "en": "My name is Li Yue."
      }
     ],
     "requires": [
      "l1_greet"
     ]
    },
    {
     "id": "l3_shi",
     "name": "A 是 B (to be)",
     "explain": "是 links two nouns: A is B. The negative is 不是. 是 is not used before adjectives.",
     "pattern": "A 是 B / A 不是 B",
     "examples": [
      {
       "zh": "我是老师。",
       "pinyin": "Wǒ shì lǎoshī.",
       "en": "I am a teacher."
      },
      {
       "zh": "我不是中国人。",
       "pinyin": "Wǒ bú shì Zhōngguó rén.",
       "en": "I am not Chinese."
      }
