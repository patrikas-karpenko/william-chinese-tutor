     "id": "l3_shenme",
     "name": "Asking 'what' with 什么",
     "explain": "什么 goes where the answer goes. The word order does not change.",
     "pattern": "你叫什么名字？ — 我叫……",
     "examples": [
      {
       "zh": "你叫什么名字？",
       "pinyin": "Nǐ jiào shénme míngzi?",
       "en": "What's your name?"
